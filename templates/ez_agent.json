            "dest_format": "%s",
            "rewrite_host": "127.0.0.1:8002",
            "editable": true,
            "timeout": null,
            "enable": true,
            "file_serve_root_path": null,
            "default_entrance": "/ezagent/index.html"
        }
    ]
