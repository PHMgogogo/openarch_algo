{
    "algorithm": {
        "id": "yolo_http_server",
        "version": "1.0.0",
        "description": "YOLO HTTP SERVER"
    },
    "entry": "uvicorn main:app --host 0.0.0.0 --port 8003 --root-path /yolo",
    "restart_always": true,
    "id": "yolo_http_server",
    "is_temporary": false,
    "restart_interval_seconds": 10.0,
    "volume": true,
    "bind_listener": false,
    "rules": [
        {
            "name": "yolo_http_server",
            "order": 1,
            "rule_type": "PREFIX",
            "pattern": "/yolo",
            "dest_index": [
                1
            ],
            "dest_format": "%s",
            "rewrite_host": "127.0.0.1:8003",
            "editable": true,
            "timeout": 60.0,
            "enable": true,
            "file_serve_root_path": null,
            "default_entrance": "/yolo/docs",
            "cors": false
        }
    ]
}