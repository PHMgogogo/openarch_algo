      "in_parameters": {
        "code": {
          "constant": "def process(node, read_data, context):\n    import torch\n    import time\n    time.sleep(1)\n    x, y = read_data[0], read_data[1]\n    factor = context.state.get(\"factor\", 2.0)\n    # 任意元素级计算 + 控制流（内置节点难以表达）\n    z = torch.where(x > factor, x * y + 1.0, x + y)\n    z_squared = z ** 2\n    # 自定义统计量写入 state\n    context.state.set(\"z_mean\", float(z.mean()))\n    context.state.set(\"z_max\", float(z.max()))\n    # 自定义文本输出\n    context.output.append(\n        \"CodeNode: factor=\" + str(factor)\n        + \", z_mean=\" + f\"{float(z.mean()):.4f}\"\n        + \", z_max=\" + f\"{float(z.max()):.4f}\"\n    )\n    return [z, z_squared], True\n",
          "state": null,
          "mode": "constant"
        }
      },
      "out_parameters": {},
      "category": "REMOTE"
    },
